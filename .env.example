# cp .env.example .env, then fill in real values. .env is gitignored — never commit it.

# Telegram — see README "Telegram in two minutes"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API — used by src/enrich/classifier.ts
ANTHROPIC_API_KEY=

# Firestore — leave GCLOUD_PROJECT + FIRESTORE_EMULATOR_HOST set for local dev
# against `npm run emulate`. Production (GitHub Actions) instead sets
# GOOGLE_APPLICATION_CREDENTIALS from the firebase-service-account repo secret.
GCLOUD_PROJECT=demo-tanitjobs-bot
FIRESTORE_EMULATOR_HOST=localhost:8095

# Firebase Storage — round-trips Playwright's storageState between runs
# (src/browser/session-state.ts). Exact bucket name from the Firebase
# console's Storage tab — don't guess .appspot.com vs .firebasestorage.app.
FIREBASE_STORAGE_BUCKET=
